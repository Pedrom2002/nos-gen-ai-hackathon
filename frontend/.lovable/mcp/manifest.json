{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "protector-pt",
      "version": "0.1.0",
      "title": "Protector PT"
    },
    "tools": [
      {
        "name": "anonymize_text",
        "title": "Anonymize text",
        "description": "Detect GDPR personal and special-category data in a (Portuguese) document and return the masked text plus the detected entities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000,
              "description": "Full document text to anonymize."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
