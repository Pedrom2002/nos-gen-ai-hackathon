# Model provider: gemini (default, needs GEMINI_API_KEY), ollama (local
# Ollama server) or openai (any local server with the OpenAI chat API:
# LM Studio, llama.cpp, vLLM). With a local provider the document never
# leaves this machine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model override. Defaults: gemini-3.1-flash-lite (gemini), gemma3:12b
# (ollama; use gemma3:4b or llama3.1:8b on a small machine). Required
# for openai (the name the server shows for the loaded model).
LLM_MODEL=
# Ollama server and context window (long documents need more than the
# Ollama default).
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
# OpenAI-compatible server; the key is optional for local servers.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
# Extra frontend origins for the API, comma separated
# (e.g. the Lovable preview). Never "*".
ALLOWED_ORIGINS=
