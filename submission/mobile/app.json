{
  "expo": {
    "name": "Lethe",
    "slug": "lethe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "pt.enxadadepedra.lethe",
      "adaptiveIcon": {
        "backgroundColor": "#2279DC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmara é usada para fotografar documentos e anonimizá-los.",
          "photosPermission": "A galeria é usada para escolher documentos a anonimizar.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "lethe",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a5fb428-48f2-4d44-9f56-1f0a67cfb0b8"
      }
    },
    "owner": "pedromarques2002"
  }
}
